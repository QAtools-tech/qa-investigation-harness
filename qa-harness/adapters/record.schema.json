{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qatools.tech/qa-harness/schemas/source-record-v1.json",
  "title": "QA harness normalized source record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "externalId", "title", "truncated", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["case", "requirement", "documentExcerpt", "runEvidence"] },
    "externalId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "excerpt": { "type": "string", "maxLength": 2000 },
    "truncated": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "instance", "project", "objectKind", "externalId", "locator", "revision", "retrievedAt"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "instance": { "type": "string", "format": "uri" },
        "project": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "objectKind": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "format": "uri" },
        "revision": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
